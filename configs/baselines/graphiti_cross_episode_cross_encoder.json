{
  "id": "graphiti_cross_episode_cross_encoder",
  "name": "Graphiti Cross-Episode Memory (Cross-Encoder Reranker)",
  "description": "Tier 2, Phase 1: Enable Graphiti's cross-encoder reranker + BFS multi-hop search. Same as graphiti_cross_episode but with search_variant='cross_encoder', which adds breadth-first search (BFS) to the edge and node search methods and replaces RRF with a learned cross-encoder reranker. Expected improvement: +5-10% J-score on multi-hop questions.",
  "type": "cross_episode_symbolic_memory",
  "retrieval_strategy": "temporal_graph_cross_encoder_reranker",
  "uses_runtime_profile": true,
  "supports_families": [
    "conversational_memory",
    "streaming_agentic_memory",
    "continual_learning",
    "long_context_reasoning"
  ],
  "local_window_policy": "external_store",
  "max_chunks_to_retrieve": 8,
  "settings": {
    "session_delimiter": "\n\n",
    "session_regex": null,
    "max_episode_chars": 2000,
    "graph_uri_env": "GRAPH_URI",
    "graph_user_env": "GRAPH_USER",
    "graph_password_env": "GRAPH_PASSWORD",
    "require_graph_uri": true,
    "require_llm_key": true,
    "prefer_current": true,
    "current_facts_only": true,
    "guided_extraction": true,
    "search_mode": "combined",
    "search_variant": "cross_encoder",
    "node_text_mode": "attributes",
    "shared_graph_key": null,
    "llm_base_url": "https://api.together.xyz/v1",
    "llm_model": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
    "small_model": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
    "embedding_model": "intfloat/multilingual-e5-large-instruct",
    "embedding_dim": 1024,
    "max_coroutines": 1,
    "num_results": 8
  }
}
